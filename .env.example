# ============ DATABASE ============
DATABASE_URL=postgresql://postgres:password@localhost:5432/facebook_automation
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=facebook_automation

# ============ OPENAI API ============
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4-turbo
OPENAI_MODEL_MINI=gpt-4o-mini

# ============ FACEBOOK GRAPH API ============
FACEBOOK_ACCESS_TOKEN=your-long-lived-token-here
FACEBOOK_PAGE_ID=your-page-id-here
FACEBOOK_API_VERSION=v18.0

# ============ SCRAPING SOURCES ============
GITHUB_TOKEN=ghp_your-token-here
HUGGINGFACE_TOKEN=hf_your-token-here
UNSPLASH_ACCESS_KEY=your-unsplash-key-here

# ============ SCHEDULER ============
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
SCRAPER_TIME=06:00
PROCESSOR_TIME=11:00
PUBLISHER_TIME=12:00

# ============ LOGGING ============
LOG_LEVEL=INFO
LOG_FILE=logs/orchestrator.log
SENTRY_DSN=

# ============ STREAMLIT ============
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_LOGGER_LEVEL=info

# ============ NOTIFICATIONS ============
# Notifications disabled - Telegram and Email removed
